{
  "collectionName": "components_shared_item_barra_superiors",
  "info": {
    "displayName": "Item Barra Superior",
    "icon": "link",
    "description": "Un ítem de la barra superior con texto y enlace."
  },
  "options": {},
  "attributes": {
    "texto": {
      "type": "string",
      "required": true
    },
    "color_texto": {
      "type": "customField",
      "customField": "global::paleta-color",
      "regex": "^#[0-9a-fA-F]{6}$",
      "description": "Elegí el color de este mensaje. Vacío conserva el color original."
    },
    "enlace": {
      "type": "string",
      "required": false
    },
    "icono": {
      "type": "enumeration",
      "enum": [
        "estrella",
        "pin"
      ],
      "default": "estrella",
      "required": true
    }
  }
}
