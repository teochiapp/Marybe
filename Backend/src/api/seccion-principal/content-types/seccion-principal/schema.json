{
  "kind": "singleType",
  "collectionName": "seccion_principal",
  "info": {
    "singularName": "seccion-principal",
    "pluralName": "secciones-principales",
    "displayName": "Página de Inicio",
    "description": "Configuración de los elementos de la Página de Inicio"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "composicion_inicio": {
      "type": "json",
      "description": "Orden y visibilidad publicados de Inicio por área"
    },
    "banners_visuales": {
      "type": "json",
      "private": true,
      "description": "Borrador y versión publicada de las piezas visuales del editor /banners-admin"
    },
    "borradores_editor_inicio": {
      "type": "json",
      "private": true,
      "description": "Borradores del Editor de Inicio (/editor-inicio-admin) por sección y área"
    },
    "diseno_categorias": {
      "type": "json",
      "description": "Sección Categorías de Inicio por área: orden de las categorías (documentId), forma de las tarjetas y estilo de los botones. Lo administra /editor-inicio-admin."
    },
    "diseno_secciones": {
      "type": "json",
      "description": "Título y tipografía de las secciones de Inicio que no tienen modelo propio (hoy: Ofertas), por sección y área. Lo administra /editor-inicio-admin."
    },
    "texto_toggle_perfumeria": {
      "type": "string",
      "default": "Perfumería"
    },
    "texto_toggle_hogar": {
      "type": "string",
      "default": "Hogar"
    },
    "secciones": {
      "type": "component",
      "repeatable": true,
      "component": "shared.seccion-principal-item",
      "required": true
    },
    "categorias_destacadas": {
      "type": "component",
      "repeatable": true,
      "component": "shared.banner-destacado",
      "max": 2
    },
    "descuento_perfumeria": {
      "type": "component",
      "repeatable": false,
      "component": "inicio.descuentos"
    },
    "descuento_hogar": {
      "type": "component",
      "repeatable": false,
      "component": "inicio.descuentos"
    },
    "destacada_perfumeria": {
      "type": "component",
      "repeatable": false,
      "component": "inicio.destacada"
    },
    "destacada_hogar": {
      "type": "component",
      "repeatable": false,
      "component": "inicio.destacada"
    },
    "categoria_especifica_perfumeria": {
      "type": "component",
      "repeatable": false,
      "component": "inicio.categoria_especifica"
    },
    "categoria_especifica_hogar": {
      "type": "component",
      "repeatable": false,
      "component": "inicio.categoria_especifica"
    }
  }
}
