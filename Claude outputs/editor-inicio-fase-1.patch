+import React from 'react';
+import styled from 'styled-components';
+import SectionCard from './SectionCard';
+import { EDITOR_INICIO_SECTIONS, sectionPath } from '../editorInicioSections';
+import { hasSectionEditor } from '../sectionEditors';
+
+const SelectorPanel = styled.section`
+  width: 100%;
+  max-width: 1320px;
+  padding: var(--spacing-lg) var(--spacing-md);
+  border: 1px solid #ece4de;
+  border-radius: var(--radius-xl);
+  background: rgba(255, 255, 255, 0.72);
+  box-shadow: 0 30px 70px -40px rgba(62, 1, 2, 0.35);
+
+  @media (min-width: 768px) {
+    padding: var(--spacing-xxl) var(--spacing-xl);
+  }
+`;
+
+const PanelHeader = styled.header`
+  max-width: 640px;
+  margin: 0 auto var(--spacing-xl);
+  text-align: center;
+
+  @media (min-width: 768px) {
+    margin-bottom: 40px;
+  }
+`;
+
+const Eyebrow = styled.p`
+  margin: 0 0 10px;
+  color: var(--color-bordo-secundario);
+  font-size: 0.72rem;
+  font-weight: 700;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+`;
+
+const PanelTitle = styled.h1`
+  margin: 0 0 12px;
+  color: var(--color-marron-principal);
+  font-family: var(--font-family-primary);
+  font-size: clamp(1.7rem, 4.2vw, 2.6rem);
+  font-weight: 600;
+  line-height: 1.15;
+`;
+
+const PanelSubtitle = styled.p`
+  margin: 0;
+  color: #6f6262;
+  font-size: 0.95rem;
+  line-height: 1.55;
+`;
+
+const SectionsGrid = styled.ol`
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: 14px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+
+  @media (min-width: 480px) { grid-template-columns: repeat(2, 1fr); }
+  @media (min-width: 768px) { grid-template-columns: repeat(3, 1fr); gap: 16px; }
+  @media (min-width: 992px) { grid-template-columns: repeat(4, 1fr); }
+  @media (min-width: 1200px) { grid-template-columns: repeat(5, 1fr); gap: 18px; }
+`;
+
+export default function SectionSelector() {
+  return (
+    <SelectorPanel aria-labelledby="editor-inicio-selector-title">
+      <PanelHeader>
+        <Eyebrow>Editor de Inicio</Eyebrow>
+        <PanelTitle id="editor-inicio-selector-title">¿Qué querés modificar hoy?</PanelTitle>
+        <PanelSubtitle>Elegí una sección de la página principal. Están ordenadas tal como aparecen en la tienda.</PanelSubtitle>
