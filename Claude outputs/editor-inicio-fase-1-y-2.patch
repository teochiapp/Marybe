@@ -0,0 +1,141 @@
+import React, { useEffect, useState } from 'react';
+import styled from 'styled-components';
+import { imageUrl } from '../../../../../utils/bannerDesign';
+import { getProductPrice } from '../../../../../utils/productPrice';
+import { MAX_PRODUCTS } from './destacadaModel';
+
+const ProductList = styled.ul`
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin: 0 0 12px;
+  padding: 0;
+  list-style: none;
+`;
+
+const ProductRow = styled.li`
+  display: grid;
+  grid-template-columns: 40px minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 9px;
+  padding: 6px;
+  border: 1px solid #eee5e3;
+  border-radius: var(--radius-md);
+  background: ${({ $selected }) => ($selected ? '#f7eeee' : 'var(--color-blanco)')};
+
+  img, span[aria-hidden] {
+    width: 40px;
+    height: 40px;
+    border-radius: 6px;
+    background: #f6f2f0;
+    object-fit: contain;
+  }
+
+  button {
+    padding: 6px 9px !important;
+    font-size: 11px !important;
+    white-space: nowrap;
+  }
+`;
+
+const ProductText = styled.div`
+  min-width: 0;
+  font-size: 11px;
+  line-height: 1.35;
+
+  small {
+    display: block;
+    color: #a08c93;
+    font-size: 9px;
+    letter-spacing: 0.06em;
+    text-transform: uppercase;
+  }
+
+  strong {
+    display: block;
+    overflow: hidden;
+    color: var(--color-marron-cuarto);
+    font-weight: 600;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+  }
+
+  span { color: var(--color-bordo-secundario); font-weight: 600; }
+`;
+
+const Counter = styled.p`
+  margin: 0 0 10px;
+  color: #7d6c72;
+  font-size: 11px;
+  font-weight: 600;
+`;
+
+const formatPrice = value => `$${Number(value || 0).toLocaleString('es-AR', { maximumFractionDigits: 0 })}`;
+
+function ProductLine({ product, selected, disabled, onToggle }) {
+  const image = product.portada ? imageUrl(product.portada) : '';
+  const { price, offerPrice } = getProductPrice(product);
+  return (
+    <ProductRow $selected={selected}>
+      {image ? <img src={image} alt="" loading="lazy" /> : <span aria-hidden="true" />}
+      <ProductText><small>{product.marca || 'Sin marca'}</small><strong title={product.nombre}>{product.nombre}</strong><span>{formatPrice(offerPrice || price)}</span></ProductText>
+      <button type="button" aria-pressed={selected} disabled={disabled && !selected} aria-label={`${selected ? 'Quitar' : 'Agregar'} ${product.nombre}`} onClick={() => onToggle(product)}>{selected ? 'Quitar' : 'Agregar'}</button>
+    </ProductRow>
+  );
+}
+
+export default function ProductosPanel({ areaLabel, data, productIndex, searchProducts, onChange }) {
+  const [query, setQuery] = useState('');
+  const [results, setResults] = useState([]);
+  const [searching, setSearching] = useState(false);
+  const [searchError, setSearchError] = useState('');
+  const selected = data.productos.map(id => productIndex[id]).filter(Boolean).sort((a, b) => a.id - b.id);
+  const missing = data.productos.length - selected.length;
+  const full = data.productos.length >= MAX_PRODUCTS;
+
+  useEffect(() => {
+    let active = true;
+    const timer = setTimeout(() => {
+      setSearching(true);
+      setSearchError('');
+      searchProducts(query.trim())
+        .then(list => { if (active) setResults(list); })
+        .catch(() => { if (active) setSearchError('No se pudo buscar productos.'); })
+        .finally(() => { if (active) setSearching(false); });
+    }, 300);
+    return () => { active = false; clearTimeout(timer); };
+  }, [query, searchProducts]);
+
+  const toggle = product => onChange(draft => {
+    draft.productos = draft.productos.includes(product.documentId)
+      ? draft.productos.filter(id => id !== product.documentId)
+      : [...draft.productos, product.documentId];
+  });
+
+  return (
+    <>
+      <p className="ba-inspector-help">Estos productos aparecen en el carrusel de la sección. En la tienda se ordenan según el catálogo.</p>
+      <details open>
+        <summary>Seleccionados</summary>
+        <Counter role="status">{data.productos.length} de {MAX_PRODUCTS} productos</Counter>
+        {!data.productos.length && <small className="ba-hint">Sin productos, la tienda muestra tarjetas vacías en el carrusel.</small>}
+        {missing > 0 && <small className="ba-hint">{missing} producto(s) seleccionados ya no están disponibles. Quitalos antes de publicar.</small>}
+        <ProductList aria-label="Productos seleccionados">
+          {selected.map(product => <ProductLine key={product.documentId} product={product} selected onToggle={toggle} />)}
+        </ProductList>
+        {missing > 0 && <button type="button" onClick={() => onChange(draft => { draft.productos = draft.productos.filter(id => productIndex[id]); })}>Quitar productos no disponibles</button>}
+      </details>
+      <details open>
+        <summary>Agregar productos</summary>
+        <label>Buscar en {areaLabel}<input type="search" value={query} placeholder="Nombre, marca o SKU" maxLength={80} onChange={event => setQuery(event.target.value)} /></label>
+        {full && <small className="ba-hint">Llegaste al máximo de {MAX_PRODUCTS} productos.</small>}
+        {searching && <p className="ba-hint" role="status">Buscando…</p>}
+        {searchError && <p className="ba-hint" role="alert">{searchError}</p>}
+        {!searching && !searchError && !results.length && <p className="ba-hint">No se encontraron productos publicados.</p>}
+        <ProductList aria-label="Resultados de búsqueda">
+          {results.map(product => <ProductLine key={product.documentId} product={product} selected={data.productos.includes(product.documentId)} disabled={full} onToggle={toggle} />)}
+        </ProductList>
+      </details>
+    </>
+  );
+}
