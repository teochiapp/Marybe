+  );
+}
diff --git a/Frontend/src/pages/admin/editor-inicio/components/destacada/DestacadaEditor.jsx b/Frontend/src/pages/admin/editor-inicio/components/destacada/DestacadaEditor.jsx
new file mode 100644
index 0000000..494fea5
--- /dev/null
+++ b/Frontend/src/pages/admin/editor-inicio/components/destacada/DestacadaEditor.jsx
@@ -0,0 +1,269 @@
+import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import axios from 'axios';
+import '../../../BannersAdmin.css';
+import { DEVICES, DEVICE_WIDTHS } from '../../../../../utils/bannerDesign';
+import EditorPreviewFrame from '../EditorPreviewFrame';
+import EditorPreviewDialog from '../EditorPreviewDialog';
+import MediaLibraryDialog from '../MediaLibraryDialog';
+import DestacadaPartsPanel from './DestacadaPartsPanel';
+import TextosPanel from './TextosPanel';
+import ImagenPanel from './ImagenPanel';
+import ProductosPanel from './ProductosPanel';
+import BannerInferiorPanel from './BannerInferiorPanel';
+import { DESTACADA_AREAS, areaInfo, bannerIndex, copy, destacadaParts, newBottomBanner, publishProblems, toPreviewData } from './destacadaModel';
+
+const API = process.env.REACT_APP_STRAPI_URL || process.env.REACT_APP_API_URL || 'http://localhost:1337';
+const NAMES = { desktop: 'Computadora', tablet: 'Tablet', mobile: 'Celular' };
+const HISTORY_LIMIT = 60;
+
+const entryFor = serverArea => {
+  const data = copy(serverArea.draft || serverArea.published);
+  return { history: [data], index: 0, baseline: JSON.stringify(data) };
+};
+const currentData = entry => entry?.history[entry.index];
+const isDirty = entry => Boolean(entry) && JSON.stringify(currentData(entry)) !== entry.baseline;
+
+export default function DestacadaEditor({ token, onBack, onLogout }) {
+  const auth = useMemo(() => ({ headers: { Authorization: `Bearer ${token}` } }), [token]);
+  const [overview, setOverview] = useState(null);
+  const [work, setWork] = useState({});
+  const [productIndex, setProductIndex] = useState({});
+  const [areaKey, setAreaKey] = useState('perfumeria');
+  const [part, setPart] = useState('textos');
+  const [device, setDevice] = useState('desktop');
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [library, setLibrary] = useState(null);
+  const [showPreview, setShowPreview] = useState(false);
+  const [scale, setScale] = useState(0.65);
+  const canvas = useRef(null);
+
+  const area = areaInfo(areaKey);
+  const entry = work[areaKey];
+  const data = currentData(entry);
+  const dirty = isDirty(entry);
+  const hasUnsaved = Object.values(work).some(isDirty);
+  const serverArea = overview?.areas?.[areaKey];
+  const hasDraft = Boolean(serverArea?.draft);
+  const parts = useMemo(() => (data ? destacadaParts(areaKey, data) : []), [areaKey, data]);
+  const activePart = parts.find(item => item.id === part) || parts[0];
+
+  const handleError = useCallback(requestError => {
+    setError(requestError.response?.data?.error?.message || requestError.message || 'No se pudo completar la operación.');
+  }, []);
+
+  const applyOverview = useCallback((next, resetArea) => {
+    setOverview(next);
+    setProductIndex(previous => ({ ...previous, ...next.products }));
+    setWork(previous => Object.fromEntries(DESTACADA_AREAS.map(({ key }) => [
+      key,
+      !previous[key] || resetArea === 'all' || key === resetArea || !isDirty(previous[key]) ? entryFor(next.areas[key]) : previous[key],
+    ])));
+  }, []);
+
+  useEffect(() => {
+    let active = true;
+    setLoading(true);
+    axios.get(`${API}/api/destacada-admin`, auth)
+      .then(response => { if (active) applyOverview(response.data.data, 'all'); })
+      .catch(requestError => { if (active) handleError(requestError); })
+      .finally(() => { if (active) setLoading(false); });
+    return () => { active = false; };
+  }, [auth, applyOverview, handleError]);
+
+  useEffect(() => {
+    const warn = event => { if (hasUnsaved) { event.preventDefault(); event.returnValue = ''; } };
+    window.addEventListener('beforeunload', warn);
+    return () => window.removeEventListener('beforeunload', warn);
+  }, [hasUnsaved]);
+
+  useEffect(() => {
+    const observer = new ResizeObserver(entries => setScale(Math.min(1, Math.max(0.2, (entries[0].contentRect.width - 40) / DEVICE_WIDTHS[device]))));
+    if (canvas.current) observer.observe(canvas.current);
+    return () => observer.disconnect();
+  }, [device, loading]);
+
+  const change = useCallback(mutator => {
+    if (busy) return;
+    setWork(previous => {
+      const current = previous[areaKey];
+      if (!current) return previous;
+      const next = copy(currentData(current));
+      mutator(next);
+      const history = [...current.history.slice(0, current.index + 1), next].slice(-HISTORY_LIMIT);
+      return { ...previous, [areaKey]: { ...current, history, index: history.length - 1 } };
+    });
+    setMessage('');
+  }, [areaKey, busy]);
+
+  const moveHistory = step => setWork(previous => {
+    const current = previous[areaKey];
+    const index = current.index + step;
+    if (index < 0 || index >= current.history.length) return previous;
+    return { ...previous, [areaKey]: { ...current, index } };
+  });
+
+  const searchProducts = useCallback(async query => {
+    const response = await axios.get(`${API}/api/destacada-admin/productos`, { ...auth, params: { area: areaKey, q: query } });
+    const list = response.data.data || [];
+    setProductIndex(previous => ({ ...previous, ...Object.fromEntries(list.map(product => [product.documentId, product])) }));
+    return list;
+  }, [auth, areaKey]);
+
+  const selectPart = useCallback(id => {
+    setPart(id);
+    setError('');
+  }, []);
+
+  const selectFromPreview = useCallback(id => {
+    if (parts.some(item => item.id === id)) selectPart(id);
+    // Los banners predeterminados (sin banners cargados) no tienen panel propio.
+    else if (bannerIndex(id) !== null && area.banners) setMessage('Ese banner es el predeterminado de la tienda. Agregá un banner inferior para reemplazarlo.');
+  }, [parts, selectPart, area.banners]);
+
+  const closePreview = useCallback(() => setShowPreview(false), []);
+
+  function selectArea(nextArea) {
+    if (busy || nextArea === areaKey) return;
+    setAreaKey(nextArea);
+    setError('');
+    setMessage('');
+    if (!areaInfo(nextArea).banners && bannerIndex(part) !== null) setPart('textos');
+  }
+
+  async function save(publish) {
+    if (publish) {
+      const problems = publishProblems(data, areaKey);
+      if (problems.length) {
+        setError(`Antes de publicar: ${problems.map(problem => problem.message).join(' ')}`);
+        setPart(problems[0].part);
+        return;
+      }
+    }
+    setBusy(true);
+    setError('');
+    setMessage('');
+    try {
+      const response = await axios.put(`${API}/api/destacada-admin/${areaKey}`, { version: overview.version, data, publish }, auth);
+      applyOverview(response.data.data, areaKey);
+      setMessage(publish ? `Publicado. La Sección Destacada de ${area.label} ya está actualizada en Inicio.` : 'Borrador guardado. La tienda sigue mostrando la última publicación.');
+    } catch (requestError) {
+      handleError(requestError);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function discardDraft() {
+    if (!window.confirm(`¿Descartar el borrador guardado de ${area.label}? Se recupera lo que está publicado.`)) return;
+    setBusy(true);
+    setError('');
+    try {
+      const response = await axios.delete(`${API}/api/destacada-admin/${areaKey}/borrador`, { ...auth, params: { version: overview.version } });
+      applyOverview(response.data.data, areaKey);
+      setMessage('Borrador descartado.');
+    } catch (requestError) {
+      handleError(requestError);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  function chooseMedia(file) {
+    const image = { id: file.id, url: file.url, name: file.name, width: file.width, height: file.height };
+    const target = library;
+    change(draft => {
+      const index = bannerIndex(target);
+      if (index !== null) draft.banners[index].imagen = image;
+      else draft[target] = image;
+    });
+    setLibrary(null);
+  }
+
+  function addBanner() {
+    const index = data.banners.length;
+    change(draft => { draft.banners.push(newBottomBanner()); });
+    setPart(`banner-${index}`);
+  }
+
+  function removeBanner(index) {
+    change(draft => { draft.banners.splice(index, 1); });
+    setPart(index > 0 ? `banner-${index - 1}` : 'productos');
+  }
+
+  const leave = action => { if (!hasUnsaved || window.confirm('Hay cambios sin guardar. ¿Querés salir igual?')) action(); };
+
+  const previewPayload = useMemo(() => (data ? { section: 'seccion-destacada', area: areaKey, previewData: toPreviewData(data, productIndex), selected: activePart?.id, mode: 'edit' } : null), [data, areaKey, productIndex, activePart]);
+
+  const statusText = !data ? 'Cargando…' : dirty ? '● Cambios sin guardar' : hasDraft ? '● Borrador sin publicar' : hasUnsaved ? '● Otros cambios pendientes' : '● Publicado';
+  const libraryTitle = library === 'imagen_mobile' ? 'Imagen para celular' : library === 'imagen_desktop' ? 'Imagen para computadora' : 'Imagen del banner inferior';
+  const index = bannerIndex(activePart?.id);
+
+  return (
+    <main className="ba-app" inert={showPreview}>
+      {showPreview && previewPayload && <EditorPreviewDialog payload={previewPayload} title={`Sección Destacada · ${area.label}`} initialDevice={device} onClose={closePreview} />}
+      <header className="ba-topbar">
+        <button type="button" className="ba-back" disabled={busy} onClick={() => leave(onBack)}>← Editor de Inicio</button>
+        <div className="ba-brand"><img src="/logo-marybe.png" alt="Marybe" width="629" height="168" /><span>Sección Destacada</span></div>
+        <span className={`ba-status ${dirty || hasDraft || hasUnsaved ? 'ba-status--dirty' : ''}`} role="status">{statusText}</span>
+        <div className="ba-top-actions">
+          <details className="ba-top-more">
+            <summary>Más opciones</summary>
+            <div>
+              <button disabled={!data || busy || !hasDraft} onClick={discardDraft}>Descartar borrador guardado</button>
+              <button disabled={!data || busy} onClick={() => change(draft => Object.assign(draft, copy(serverArea.published)))}>Volver a lo publicado</button>
+              <button disabled={busy} onClick={() => leave(onLogout)}>Salir</button>
+            </div>
+          </details>
+          <button className="ba-preview-open" disabled={!data || loading} onClick={() => setShowPreview(true)}>Vista previa</button>
+          <button disabled={!data || busy || !dirty} onClick={() => save(false)}>Guardar borrador</button>
+          <button className="ba-primary" disabled={!data || busy || (!dirty && !hasDraft)} onClick={() => save(true)}>{busy ? 'Guardando…' : 'Publicar cambios'}</button>
+        </div>
+      </header>
+      <div className="ba-locationbar">
+        <div><p className="ba-eyebrow">TIENDA / EDITOR VISUAL</p><h1>Sección Destacada</h1></div>
+        <div className="ba-area-tabs" role="group" aria-label="Área de Inicio">
+          {DESTACADA_AREAS.map(item => <button key={item.key} disabled={busy || loading} aria-pressed={areaKey === item.key} onClick={() => selectArea(item.key)}>{item.label}{isDirty(work[item.key]) ? ' •' : ''}</button>)}
+        </div>
+        <p>«Lo nuevo en Marybe» de <strong>{area.label}</strong></p>
+      </div>
+      {(error || message) && <div className={`ba-notice ${error ? 'ba-notice--error' : ''}`} role={error ? 'alert' : 'status'}>{error || message}<button onClick={() => { setError(''); setMessage(''); }} aria-label="Cerrar mensaje">×</button></div>}
+      <div className="ba-workspace">
+        {data ? <DestacadaPartsPanel areaKey={areaKey} data={data} selected={activePart?.id} busy={busy} onSelect={selectPart} onAddBanner={addBanner} /> : <aside className="ba-sidebar"><p role="status">{loading ? 'Cargando sección…' : 'No se pudo cargar la sección.'}</p></aside>}
+
+        <section className="ba-stage">
+          <div className="ba-preview-toolbar">
+            <div className="ba-device-tabs">{DEVICES.map(value => <button key={value} className={device === value ? 'is-active' : ''} aria-pressed={device === value} onClick={() => setDevice(value)}>{NAMES[value]}</button>)}</div>
+            <span>{DEVICE_WIDTHS[device]} px · {Math.round(scale * 100)}%</span>
+            <div className="ba-undo">
+              <button aria-label="Deshacer" disabled={!entry || entry.index <= 0 || busy} onClick={() => moveHistory(-1)}>↶</button>
+              <button aria-label="Rehacer" disabled={!entry || entry.index >= entry.history.length - 1 || busy} onClick={() => moveHistory(1)}>↷</button>
+            </div>
+          </div>
+          <div className="ba-canvas" ref={canvas}>
+            {previewPayload ? <>
+              <div className="ba-canvas-caption">VISTA PREVIA · LO NUEVO EN MARYBE · {area.label.toUpperCase()}</div>
+              <EditorPreviewFrame payload={previewPayload} width={DEVICE_WIDTHS[device]} scale={scale} title="Vista previa de la Sección Destacada" onSelect={selectFromPreview} />
+              <p className="ba-canvas-tip">Hacé clic en una parte de la sección para editarla. Tu vista previa es privada.</p>
+            </> : <div className="ba-empty"><h2>{loading ? 'Cargando…' : 'No se pudo cargar la Sección Destacada'}</h2></div>}
+          </div>
+        </section>
+
+        <aside className="ba-inspector">
+          <div className="ba-inspector-title">
+            <p className="ba-eyebrow">PERSONALIZAR</p>
+            <h2>{activePart?.label || 'Sección Destacada'}</h2>
+            <span>{area.label} · {NAMES[device]}</span>
+          </div>
+          {data && activePart?.id === 'textos' && <TextosPanel areaKey={areaKey} data={data} onChange={change} />}
+          {data && activePart?.id === 'imagen' && <ImagenPanel data={data} device={device} onChooseImage={setLibrary} onChange={change} />}
+          {data && activePart?.id === 'productos' && <ProductosPanel areaLabel={area.label} data={data} productIndex={productIndex} searchProducts={searchProducts} onChange={change} />}
+          {data && index !== null && data.banners[index] && <BannerInferiorPanel index={index} banner={data.banners[index]} onChooseImage={setLibrary} onChange={change} onRemove={() => removeBanner(index)} />}
+        </aside>
+      </div>
+      {library && <MediaLibraryDialog token={token} title={libraryTitle} onChoose={chooseMedia} onClose={() => setLibrary(null)} />}
+    </main>
+  );
+}
diff --git a/Frontend/src/pages/admin/editor-inicio/components/destacada/DestacadaEditor.test.jsx b/Frontend/src/pages/admin/editor-inicio/components/destacada/DestacadaEditor.test.jsx
new file mode 100644
index 0000000..572b7e9
--- /dev/null
+++ b/Frontend/src/pages/admin/editor-inicio/components/destacada/DestacadaEditor.test.jsx
@@ -0,0 +1,106 @@
+import React from 'react';
+import '@testing-library/jest-dom';
+import { render, screen, fireEvent, waitFor, within } from '@testing-library/react';
+import axios from 'axios';
+import DestacadaEditor from './DestacadaEditor';
+import { publishProblems, toPreviewData } from './destacadaModel';
+
+jest.mock('axios');
+jest.mock('react-router-dom', () => ({ Link: ({ children }) => <span>{children}</span> }), { virtual: true });
+
+const image = { id: 10, url: '/uploads/hero.webp', name: 'hero.webp' };
+const published = { titulo_cursiva: 'Lo nuevo', titulo_normal: 'en Marybe', color_titulo_cursiva: '', color_titulo_normal: '', subtitulo: 'Sub', imagen_desktop: image, imagen_mobile: null, banners: [{ titulo: 'Elixir', imagen: image, texto_boton: 'Conocer más', link_boton: '/tienda' }], productos: ['p1'] };
+const overview = (overrides = {}) => ({
+  version: 'v1',
+  exists: true,
+  areas: {
+    perfumeria: { published, draft: null, draftSavedAt: null },
+    hogar: { published: { ...published, titulo_cursiva: 'Tu espacio,', banners: [], productos: [] }, draft: null, draftSavedAt: null },
+  },
+  products: { p1: { id: 1, documentId: 'p1', nombre: 'Perfume Uno', marca: 'QA', precio: 1000 } },
+  ...overrides,
+});
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  global.ResizeObserver = class { observe() {} disconnect() {} };
+  axios.get.mockImplementation(async url => (url.endsWith('/productos')
+    ? { data: { data: [{ id: 2, documentId: 'p2', nombre: 'Perfume Dos', marca: 'QA', precio: 2000 }] } }
+    : { data: { data: overview() } }));
+  axios.put.mockImplementation(async (url, body) => ({ data: { data: overview({ version: 'v2', areas: { ...overview().areas, perfumeria: body.publish ? { published: body.data, draft: null } : { published, draft: body.data } } }) } }));
+});
+
+const renderEditor = props => render(<DestacadaEditor token="fixture-token" onBack={jest.fn()} onLogout={jest.fn()} {...props} />);
+
+test('carga la sección con el token administrativo y muestra sus partes', async () => {
+  renderEditor();
+  expect(await screen.findByLabelText('Primera parte (cursiva)')).toHaveValue('Lo nuevo');
+  expect(axios.get).toHaveBeenCalledWith(expect.stringMatching(/\/api\/destacada-admin$/), { headers: { Authorization: 'Bearer fixture-token' } });
+  const parts = screen.getByRole('navigation', { name: 'Partes de la Sección Destacada' });
+  expect(within(parts).getAllByRole('button').map(button => button.getAttribute('aria-label'))).toEqual(['Editar Título y subtítulo', 'Editar Imagen principal', 'Editar Productos destacados', 'Editar Banner inferior 1']);
+  expect(screen.getByTitle('Vista previa de la Sección Destacada')).toHaveAttribute('src', '/editor-inicio-preview');
+});
+
+test('guardar borrador y publicar envían el área, la versión y los datos editados', async () => {
+  renderEditor();
+  fireEvent.change(await screen.findByLabelText('Primera parte (cursiva)'), { target: { value: 'Lo más nuevo' } });
+  expect(screen.getByText('● Cambios sin guardar')).toBeInTheDocument();
+  fireEvent.click(screen.getByRole('button', { name: 'Guardar borrador' }));
+  await waitFor(() => expect(axios.put).toHaveBeenCalledTimes(1));
+  const [url, body] = axios.put.mock.calls[0];
+  expect(url).toMatch(/\/api\/destacada-admin\/perfumeria$/);
+  expect(body).toEqual(expect.objectContaining({ version: 'v1', publish: false }));
+  expect(body.data.titulo_cursiva).toBe('Lo más nuevo');
+  await screen.findByText('Borrador guardado. La tienda sigue mostrando la última publicación.');
+  expect(screen.getByText('● Borrador sin publicar')).toBeInTheDocument();
+  fireEvent.click(screen.getByRole('button', { name: 'Publicar cambios' }));
+  await waitFor(() => expect(axios.put).toHaveBeenCalledTimes(2));
+  expect(axios.put.mock.calls[1][1]).toEqual(expect.objectContaining({ version: 'v2', publish: true }));
+});
+
+test('no publica si falta el título y lleva al panel con el problema', async () => {
+  renderEditor();
+  fireEvent.click(await screen.findByRole('button', { name: 'Editar Imagen principal' }));
+  fireEvent.click(screen.getByRole('button', { name: 'Editar Título y subtítulo' }));
+  fireEvent.change(screen.getByLabelText('Segunda parte'), { target: { value: '' } });
+  fireEvent.click(screen.getByRole('button', { name: 'Editar Productos destacados' }));
+  fireEvent.click(screen.getByRole('button', { name: 'Publicar cambios' }));
+  expect(await screen.findByRole('alert')).toHaveTextContent('Completá las dos partes del título.');
+  expect(screen.getByRole('heading', { level: 2, name: 'Título y subtítulo' })).toBeInTheDocument();
+  expect(axios.put).not.toHaveBeenCalled();
+});
+
+test('agrega productos desde la búsqueda y Hogar no ofrece banners inferiores', async () => {
+  renderEditor();
+  fireEvent.click(await screen.findByRole('button', { name: 'Editar Productos destacados' }));
+  fireEvent.click(await screen.findByRole('button', { name: 'Agregar Perfume Dos' }));
+  expect(screen.getByText('2 de 40 productos')).toBeInTheDocument();
+  expect(axios.get).toHaveBeenCalledWith(expect.stringMatching(/\/api\/destacada-admin\/productos$/), expect.objectContaining({ params: { area: 'perfumeria', q: '' } }));
+  fireEvent.click(screen.getByRole('button', { name: 'Hogar' }));
+  expect(screen.getByText('0 de 40 productos')).toBeInTheDocument();
+  fireEvent.click(screen.getByRole('button', { name: 'Editar Título y subtítulo' }));
+  expect(screen.getByLabelText('Primera parte (cursiva)')).toHaveValue('Tu espacio,');
+  expect(screen.queryByRole('button', { name: 'Editar Banner inferior 1' })).toBeNull();
+  expect(screen.getByRole('button', { name: 'Perfumería •' })).toBeInTheDocument();
+});
+
+test('volver al selector pide confirmación con cambios sin guardar', async () => {
+  const onBack = jest.fn();
+  const confirm = jest.spyOn(window, 'confirm').mockReturnValue(false);
+  renderEditor({ onBack });
+  fireEvent.change(await screen.findByLabelText('Primera parte (cursiva)'), { target: { value: 'Otro' } });
+  fireEvent.click(screen.getByRole('button', { name: '← Editor de Inicio' }));
+  expect(onBack).not.toHaveBeenCalled();
+  confirm.mockReturnValue(true);
+  fireEvent.click(screen.getByRole('button', { name: '← Editor de Inicio' }));
+  expect(onBack).toHaveBeenCalledTimes(1);
+  confirm.mockRestore();
+});
+
+test('la vista previa usa el orden del catálogo y la validación replica la del backend', () => {
+  const index = { a: { id: 9, documentId: 'a' }, b: { id: 3, documentId: 'b' } };
+  expect(toPreviewData({ ...published, productos: ['a', 'b', 'gone'] }, index).productos.map(product => product.documentId)).toEqual(['b', 'a']);
+  expect(publishProblems(published, 'perfumeria')).toEqual([]);
+  expect(publishProblems({ ...published, imagen_desktop: null, banners: [{ titulo: '', imagen: null, texto_boton: '' }] }, 'perfumeria').map(problem => problem.part)).toEqual(['imagen', 'banner-0']);
+  expect(publishProblems({ ...published, banners: [{ titulo: '' }] }, 'hogar')).toEqual([]);
