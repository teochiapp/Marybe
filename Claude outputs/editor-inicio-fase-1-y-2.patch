diff --git a/Frontend/src/pages/admin/editor-inicio/EditorInicioPreview.jsx b/Frontend/src/pages/admin/editor-inicio/EditorInicioPreview.jsx
new file mode 100644
index 0000000..9e61332
--- /dev/null
+++ b/Frontend/src/pages/admin/editor-inicio/EditorInicioPreview.jsx
@@ -0,0 +1,92 @@
+import React, { useState, useEffect } from 'react';
+import styled from 'styled-components';
+import FeaturedSection from '../../../components/inicio/perfumeria/FeaturedSection';
+import FeaturedSectionHogar from '../../../components/inicio/hogar/FeaturedSectionHogar';
+
+const PreviewPage = styled.main`
+  min-height: 100px;
+  padding: 30px 0 40px;
+  background: var(--color-blanco);
+  font-family: var(--font-family-secondary);
+
+  &[data-mode='edit'] [data-editor-part] {
+    cursor: pointer;
+    transition: outline-color 0.15s ease;
+    outline: 2px dashed transparent;
+    outline-offset: 4px;
+  }
+
+  &[data-mode='edit'] [data-editor-part]:hover {
+    outline-color: rgba(242, 220, 143, 0.9);
+  }
+
+  ${({ $selected }) => $selected && `
+    &[data-mode='edit'] [data-editor-part='${$selected}'] {
+      outline: 3px solid #f2dc8f;
+      outline-offset: 4px;
+    }
+  `}
+`;
+
+const PREVIEWS = {
+  'seccion-destacada': ({ area, previewData }) => (area === 'hogar'
+    ? <FeaturedSectionHogar previewData={previewData} />
+    : <FeaturedSection seccion="perfumeria" previewData={previewData} />),
+};
+
+const send = data => window.parent.postMessage(data, window.location.origin);
+
+// Lienzo interno del Editor de Inicio: recibe borradores del editor (mismo origen) y renderiza
+// las secciones reales de la landing. No consulta borradores en la API pública.
+export default function EditorInicioPreview() {
+  const [preview, setPreview] = useState(null);
+
+  useEffect(() => {
+    const receive = event => {
+      if (event.origin !== window.location.origin || event.source !== window.parent || event.data?.type !== 'MARYBE_EDITOR_PREVIEW') return;
+      setPreview(event.data.payload);
+    };
+    window.addEventListener('message', receive);
+    send({ type: 'MARYBE_EDITOR_READY' });
+    // Evita que el fondo oscuro del sitio asome mientras el lienzo ajusta su alto.
+    const previousBackground = document.body.style.backgroundColor;
+    document.body.style.backgroundColor = '#ffffff';
+    return () => {
+      window.removeEventListener('message', receive);
+      document.body.style.backgroundColor = previousBackground;
+    };
+  }, []);
+
+  useEffect(() => {
+    const target = document.getElementById('editor-inicio-preview-content');
+    if (!target) return undefined;
+    const observer = new ResizeObserver(() => send({ type: 'MARYBE_EDITOR_HEIGHT', height: target.getBoundingClientRect().height }));
+    observer.observe(target);
+    return () => observer.disconnect();
+  }, [preview]);
+
+  useEffect(() => {
+    if (preview?.mode !== 'view') return undefined;
+    const keyboard = event => { if (event.key === 'Escape') send({ type: 'MARYBE_EDITOR_CLOSE_PREVIEW' }); };
+    window.addEventListener('keydown', keyboard);
+    return () => window.removeEventListener('keydown', keyboard);
+  }, [preview?.mode]);
+
+  if (!preview) return <p style={{ textAlign: 'center', padding: 32 }}>Preparando vista previa…</p>;
+  const Preview = PREVIEWS[preview.section];
+  if (!Preview) return <p style={{ textAlign: 'center', padding: 32 }}>Sección sin vista previa.</p>;
+
+  const handleClickCapture = event => {
+    if (event.target.closest('[aria-label="Anterior"], [aria-label="Siguiente"]')) return;
+    event.preventDefault();
+    event.stopPropagation();
+    const part = event.target.closest('[data-editor-part]')?.dataset.editorPart;
+    if (preview.mode === 'edit' && part) send({ type: 'MARYBE_EDITOR_SELECT', part });
+  };
+
+  return (
+    <PreviewPage id="editor-inicio-preview-content" data-mode={preview.mode} $selected={/^[a-z0-9-]+$/.test(preview.selected || '') ? preview.selected : ''} onClickCapture={handleClickCapture}>
+      <Preview area={preview.area} previewData={preview.previewData} />
+    </PreviewPage>
+  );
+}
diff --git a/Frontend/src/pages/admin/editor-inicio/components/EditorPreviewDialog.jsx b/Frontend/src/pages/admin/editor-inicio/components/EditorPreviewDialog.jsx
new file mode 100644
index 0000000..ac6827f
--- /dev/null
+++ b/Frontend/src/pages/admin/editor-inicio/components/EditorPreviewDialog.jsx
@@ -0,0 +1,56 @@
+import React, { useEffect, useMemo, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { DEVICES, DEVICE_WIDTHS } from '../../../../utils/bannerDesign';
+import EditorPreviewFrame from './EditorPreviewFrame';
+
+const NAMES = { desktop: 'Computadora', tablet: 'Tablet', mobile: 'Celular' };
+
+// Vista previa limpia (sin marcas de edición) a pantalla completa, igual que en el editor de banners.
+export default function EditorPreviewDialog({ payload, title, initialDevice = 'desktop', onClose }) {
+  const [device, setDevice] = useState(initialDevice);
+  const [availableWidth, setAvailableWidth] = useState(1280);
+  const [fit, setFit] = useState(true);
+  const canvas = useRef(null);
+  const close = useRef(null);
+  const width = DEVICE_WIDTHS[device];
+  const scale = fit ? Math.min(1, Math.max(0.2, (availableWidth - 40) / width)) : 1;
+  const viewPayload = useMemo(() => ({ ...payload, mode: 'view' }), [payload]);
+
+  useEffect(() => {
+    const previousOverflow = document.body.style.overflow;
+    const previousFocus = document.activeElement;
+    document.body.style.overflow = 'hidden';
+    close.current?.focus();
+    const keyboard = event => { if (event.key === 'Escape') { event.preventDefault(); onClose(); } };
+    document.addEventListener('keydown', keyboard);
+    return () => {
+      document.body.style.overflow = previousOverflow;
+      document.removeEventListener('keydown', keyboard);
+      previousFocus?.focus?.();
+    };
+  }, [onClose]);
+
+  useEffect(() => {
+    const observer = new ResizeObserver(entries => setAvailableWidth(entries[0].contentRect.width));
+    if (canvas.current) observer.observe(canvas.current);
+    return () => observer.disconnect();
+  }, []);
+
+  return createPortal(
+    <section className="ba-app ba-live-preview" role="dialog" aria-modal="true" aria-labelledby="editor-inicio-preview-title">
+      <header className="ba-live-preview-header">
+        <div><p className="ba-eyebrow">VISTA PREVIA PRIVADA</p><h2 id="editor-inicio-preview-title">{title}</h2><p>Revisá la sección completa antes de publicar.</p></div>
+        <button ref={close} className="ba-primary" onClick={onClose}>Volver al editor</button>
+      </header>
+      <div className="ba-live-preview-toolbar">
+        <div className="ba-device-tabs">{DEVICES.map(value => <button key={value} aria-pressed={device === value} className={device === value ? 'is-active' : ''} onClick={() => setDevice(value)}>{NAMES[value]}</button>)}</div>
+        <span>{width} px · {Math.round(scale * 100)}%</span>
+        <div className="ba-live-preview-zoom"><button aria-pressed={fit} onClick={() => setFit(true)}>Ajustar a pantalla</button><button aria-pressed={!fit} onClick={() => setFit(false)}>Tamaño real 100%</button></div>
+      </div>
+      <div className="ba-live-preview-canvas" ref={canvas}>
+        <EditorPreviewFrame payload={viewPayload} width={width} scale={scale} title={`Vista previa limpia: ${title}`} onClose={onClose} />
+      </div>
+    </section>,
+    document.body,
+  );
+}
diff --git a/Frontend/src/pages/admin/editor-inicio/components/EditorPreviewFrame.jsx b/Frontend/src/pages/admin/editor-inicio/components/EditorPreviewFrame.jsx
new file mode 100644
index 0000000..e50ab3f
--- /dev/null
+++ b/Frontend/src/pages/admin/editor-inicio/components/EditorPreviewFrame.jsx
@@ -0,0 +1,38 @@
+import React, { useEffect, useRef, useState } from 'react';
+
+// Iframe del lienzo /editor-inicio-preview: envía el borrador y recibe alto, selección y cierre.
+export default function EditorPreviewFrame({ payload, width, scale, title, onSelect, onClose }) {
+  const frame = useRef(null);
+  const [ready, setReady] = useState(0);
+  const [height, setHeight] = useState(720);
+
+  useEffect(() => {
+    const receive = event => {
+      if (event.origin !== window.location.origin || event.source !== frame.current?.contentWindow) return;
+      const { data } = event;
+      if (data?.type === 'MARYBE_EDITOR_READY') setReady(value => value + 1);
+      if (data?.type === 'MARYBE_EDITOR_HEIGHT' && Number.isFinite(data.height)) setHeight(Math.min(16000, Math.max(200, Math.ceil(data.height))));
+      if (data?.type === 'MARYBE_EDITOR_SELECT' && typeof data.part === 'string') onSelect?.(data.part);
+      if (data?.type === 'MARYBE_EDITOR_CLOSE_PREVIEW') onClose?.();
+    };
+    window.addEventListener('message', receive);
+    return () => window.removeEventListener('message', receive);
+  }, [onSelect, onClose]);
+
+  useEffect(() => {
+    const timer = setTimeout(() => frame.current?.contentWindow?.postMessage({ type: 'MARYBE_EDITOR_PREVIEW', payload }, window.location.origin), 60);
+    return () => clearTimeout(timer);
+  }, [payload, ready]);
+
+  return (
+    <div className="ba-frame-shell" style={{ width: width * scale, height: height * scale }}>
+      <iframe
+        title={title}
+        src="/editor-inicio-preview"
+        ref={frame}
+        onLoad={() => setReady(value => value + 1)}
+        style={{ width, height, transform: `scale(${scale})` }}
+      />
+    </div>
+  );
+}
diff --git a/Frontend/src/pages/admin/editor-inicio/components/MediaLibraryDialog.jsx b/Frontend/src/pages/admin/editor-inicio/components/MediaLibraryDialog.jsx
new file mode 100644
index 0000000..6c9783f
--- /dev/null
+++ b/Frontend/src/pages/admin/editor-inicio/components/MediaLibraryDialog.jsx
@@ -0,0 +1,75 @@
+import React, { useEffect, useState } from 'react';
+import axios from 'axios';
+import { imageUrl } from '../../../../utils/bannerDesign';
+
+const API = process.env.REACT_APP_STRAPI_URL || process.env.REACT_APP_API_URL || 'http://localhost:1337';
+
+// Biblioteca de imágenes del Editor de Inicio: reutiliza los endpoints del editor de banners.
+export default function MediaLibraryDialog({ token, title, onChoose, onClose }) {
+  const [media, setMedia] = useState([]);
+  const [search, setSearch] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const auth = { headers: { Authorization: `Bearer ${token}` } };
+
+  useEffect(() => {
+    let active = true;
+    axios.get(`${API}/api/banners-admin/media`, { headers: { Authorization: `Bearer ${token}` } })
+      .then(response => { if (active) setMedia(response.data.data || []); })
+      .catch(requestError => { if (active) setError(requestError.response?.data?.error?.message || 'No se pudo cargar la biblioteca.'); })
+      .finally(() => { if (active) setLoading(false); });
+    return () => { active = false; };
+  }, [token]);
+
+  useEffect(() => {
+    const keyboard = event => { if (event.key === 'Escape' && !busy) onClose(); };
+    document.addEventListener('keydown', keyboard);
+    return () => document.removeEventListener('keydown', keyboard);
+  }, [busy, onClose]);
+
+  async function upload(file) {
+    if (!file) return;
+    setBusy(true);
+    setError('');
+    try {
+      const data = new FormData();
+      data.append('files', file);
+      const response = await axios.post(`${API}/api/banners-admin/upload`, data, auth);
+      onChoose(response.data.data[0]);
+    } catch (requestError) {
+      setError(requestError.response?.data?.error?.message || 'No se pudo subir la imagen.');
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const visible = media.filter(file => file.name?.toLowerCase().includes(search.toLowerCase()));
+
+  return (
+    <div className="ba-modal-backdrop" onClick={() => !busy && onClose()}>
+      <section className="ba-media-modal" role="dialog" aria-modal="true" aria-label="Biblioteca de imágenes" onClick={event => event.stopPropagation()}>
+        <header>
+          <div><p className="ba-eyebrow">BIBLIOTECA MARYBE</p><h2>{title}</h2></div>
+          <button aria-label="Cerrar biblioteca" disabled={busy} onClick={onClose}>×</button>
+        </header>
+        {error && <p role="alert" style={{ color: '#a53a37' }}>{error}</p>}
+        <div className="ba-media-toolbar">
+          <input aria-label="Buscar imagen" placeholder="Buscar en las últimas 200 imágenes…" value={search} onChange={event => setSearch(event.target.value)} />
+          <label className="ba-upload">{busy ? 'Subiendo…' : '＋ Subir imagen'}<input type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" disabled={busy} onChange={event => upload(event.target.files[0])} /></label>
+        </div>
+        <p>JPG, PNG, WebP, GIF o AVIF · máximo 10 MB</p>
+        {loading && <p role="status">Cargando imágenes…</p>}
+        <div className="ba-media-grid">
+          {visible.map(file => (
+            <button key={file.id} disabled={busy} onClick={() => onChoose(file)}>
+              <img src={imageUrl(file, API)} alt={file.name} loading="lazy" />
+              <strong>{file.name}</strong>
+              <small>{file.width} × {file.height}</small>
+            </button>
+          ))}
+        </div>
+      </section>
+    </div>
+  );
+}
diff --git a/Frontend/src/pages/admin/editor-inicio/components/destacada/BannerInferiorPanel.jsx b/Frontend/src/pages/admin/editor-inicio/components/destacada/BannerInferiorPanel.jsx
