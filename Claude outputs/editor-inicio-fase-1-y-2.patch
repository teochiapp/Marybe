+    landingComponent: 'FeaturedSection',
+  },
+  {
+    id: 'categorias',
+    title: 'Categorías',
+    description: 'Accesos rápidos a las categorías de la tienda.',
+    icon: FiGrid,
+    landingComponent: 'CategoriesSection',
+  },
+  {
